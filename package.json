{
  "name": "react-navplus",
  "version": "3.0.0",
  "description": "A navigation link for React with one API across React Router, TanStack Router and wouter: segment-aware active state, prefetching, hover and delayed navigation",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react-router": {
      "import": {
        "types": "./dist/react-router.d.ts",
        "default": "./dist/react-router.js"
      },
      "require": {
        "types": "./dist/react-router.d.cts",
        "default": "./dist/react-router.cjs"
      }
    },
    "./tanstack-router": {
      "import": {
        "types": "./dist/tanstack-router.d.ts",
        "default": "./dist/tanstack-router.js"
      },
      "require": {
        "types": "./dist/tanstack-router.d.cts",
        "default": "./dist/tanstack-router.cjs"
      }
    },
    "./wouter": {
      "import": {
        "types": "./dist/wouter.d.ts",
        "default": "./dist/wouter.js"
      },
      "require": {
        "types": "./dist/wouter.d.cts",
        "default": "./dist/wouter.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "react-router": [
        "./dist/react-router.d.ts"
      ],
      "tanstack-router": [
        "./dist/tanstack-router.d.ts"
      ],
      "wouter": [
        "./dist/wouter.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test -- --runInBand && npm run build && npm run test:package",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:package": "node --test tests/package/*.test.mjs",
    "lint": "eslint src tests --ext .ts,.tsx",
    "clean": "rimraf dist"
  },
  "keywords": [
    "react",
    "navigation",
    "navlink",
    "link",
    "router",
    "react-router",
    "tanstack-router",
    "wouter",
    "active-link",
    "prefetch",
    "accessibility",
    "typescript",
    "tree-shaking",
    "multi-router"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/WalterOb/react-navplus.git"
  },
  "bugs": {
    "url": "https://github.com/WalterOb/react-navplus/issues"
  },
  "homepage": "https://github.com/WalterOb/react-navplus#readme",
  "author": {
    "name": "WalterOb",
    "url": "https://github.com/WalterOb"
  },
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
  },
  "peerDependencies": {
    "@tanstack/react-router": ">=1.0.0",
    "react": ">=16.14.0",
    "react-router-dom": ">=6.0.0",
    "wouter": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-router": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    },
    "wouter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-router": "^1.170.39",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.4",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.6.2",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.3.3",
    "whatwg-fetch": "^3.6.20",
    "wouter": "^3.11.0"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ]
}
